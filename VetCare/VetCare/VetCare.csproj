<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 (requisito de la cátedra). -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ConfigurationManager (lectura de App.config) es parte de .NET Framework. -->
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLL_60MN\BLL_60MN.csproj" />
    <ProjectReference Include="..\Entidades_60MN\Entidades_60MN.csproj" />
    <ProjectReference Include="..\Seguridad_60MN\Seguridad_60MN.csproj" />
    <ProjectReference Include="..\Servicios_60MN\Servicios_60MN.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Usuario de emergencia (fuera de la base de datos). Se genera con Herramientas_60MN/GeneradorScriptBD_60MN. -->
    <None Update="UsuarioEmergencia_60MN.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
