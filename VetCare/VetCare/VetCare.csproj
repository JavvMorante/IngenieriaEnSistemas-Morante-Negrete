<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 (requisito de la cátedra). -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ConfigurationManager (lectura de App.config) es parte de .NET Framework. -->
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLL_60MN\BLL_60MN.csproj" />
    <ProjectReference Include="..\Entidades_60MN\Entidades_60MN.csproj" />
    <ProjectReference Include="..\Seguridad_60MN\Seguridad_60MN.csproj" />
    <ProjectReference Include="..\Servicios_60MN\Servicios_60MN.csproj" />
  </ItemGroup>

  <!--
    DESHABILITADO POR AHORA: proceso de negocio Gestión de Stock (CUN11 a CUN15) y Bitácora de cambios.
    Los archivos siguen en el proyecto (se ven en el Explorador de soluciones) pero no se compilan.
    Para reactivarlos: borrar este ItemGroup y descomentar las líneas marcadas en FrmMenuPrincipal_60MN.cs.
  -->
  <ItemGroup>
    <Compile Remove="Stock\**" />
    <EmbeddedResource Remove="Stock\**" />
    <None Include="Stock\**" />
    <Compile Remove="Seguridad\FrmBitacoraCambios_60MN*.cs;Seguridad\FrmCompararVersiones_60MN*.cs" />
    <EmbeddedResource Remove="Seguridad\FrmBitacoraCambios_60MN.resx;Seguridad\FrmCompararVersiones_60MN.resx" />
    <None Include="Seguridad\FrmBitacoraCambios_60MN*.*;Seguridad\FrmCompararVersiones_60MN*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Usuario de emergencia (fuera de la base de datos). Se genera con Herramientas_60MN/GeneradorScriptBD_60MN. -->
    <None Update="UsuarioEmergencia_60MN.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
