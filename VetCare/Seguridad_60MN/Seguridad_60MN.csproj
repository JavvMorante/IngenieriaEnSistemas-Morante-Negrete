<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8 (requisito de la cátedra). -->
    <TargetFramework>net48</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Seguridad_60MN</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient: reemplazo oficial y mantenido de System.Data.SqlClient
         (misma API: SqlConnection/SqlCommand/SqlDataReader, cambia solo el namespace).
         Soporta .NET Framework 4.6.2 o superior. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />

    <!-- ConfigurationManager (lectura de <appSettings> del App.config) es parte de .NET Framework. -->
    <Reference Include="System.Configuration" />
  </ItemGroup>

</Project>
